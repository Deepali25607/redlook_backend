# Postgres connection — Docker compose setup uses port 5433 to avoid
# colliding with any other Postgres on the host.
#   Docker compose: postgresql://redlook:redlook@localhost:5433/redlook
#   Neon / Supabase: paste the full URL they give you (with ?sslmode=require)
DATABASE_URL="postgresql://redlook:redlook@localhost:5433/redlook"

# Server — 4001 leaves :4000 free for any sibling API running locally.
PORT=4001

# JWT — generate a long random string in real environments
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS — comma-separated list of allowed frontend origins. Redlook
# frontend dev server defaults to :5174.
CORS_ORIGINS="http://localhost:5174,http://localhost:5173"

# ImageKit.io — image upload + CDN. All three must be set together; if
# any is missing, /api/admin/uploads/* returns 503 with a clear message.
# Sign up at https://imagekit.io (free tier: 20 GB bandwidth + 20 GB
# storage / month; INR billing). Find the keys at:
#   Developer → API Keys → Public key / Private key
#   Developer → URL endpoints → e.g. https://ik.imagekit.io/<your_id>
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Suppress the Prisma "Update available" notice. Pinned at 5.22.
PRISMA_HIDE_UPDATE_MESSAGE=true

# Razorpay (UPI / Card / Netbanking) — leave blank to keep UPI hidden.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# MSG91 — SMS provider for phone-OTP. Until both are set, the notify
# dispatcher logs SMS bodies to stdout (dev fallback). Optional once
# Firebase Phone Auth is configured below — MSG91 is kept as the
# legacy fallback path that /auth/register, /auth/login etc still use.
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# Firebase Phone Auth (Google) — newer storefront auth path. Google
# sends + verifies the SMS OTP on the client; we just verify the
# resulting ID token here. Free up to 10k OTPs/month.
#
# How to get the value:
#   Firebase Console → Project settings (gear icon) → Service accounts
#     → "Generate new private key" → downloads a JSON file.
#   Paste the ENTIRE JSON (one line, no newlines around it) as the
#   value here. Render/CI may strip the embedded \n inside private_key
#   — if you hit "Invalid PEM" on startup, base64-encode the JSON and
#   the loader will detect and decode it.
#
# When unset, the /auth/firebase-* endpoints return 503 and the
# legacy MSG91 paths keep working untouched.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# OTP_ECHO_FOR_TESTING — when 'true' AND MSG91 is empty, the API echoes
# fresh OTPs in the response body. SECURITY: leave unset in production.
OTP_ECHO_FOR_TESTING=""
